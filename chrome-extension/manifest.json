{
  "manifest_version": 3,
  "name": "Close Stations",
  "version": "0.2.1",
  "description": "Use listing map coordinates to find nearby TfL stations and reverse-geocode the pin.",
  "permissions": ["activeTab", "storage", "scripting"],
  "icons": {
    "16": "icons/nearby-stations@16.png",
    "32": "icons/nearby-stations@32.png",
    "48": "icons/nearby-stations@48.png",
    "128": "icons/nearby-stations@128.png"
  },
  "host_permissions": [
    "https://api.tfl.gov.uk/*",
    "https://nominatim.openstreetmap.org/*",
    "https://www.rightmove.co.uk/*",
    "https://www.zoopla.co.uk/*",
    "https://www.onthemarket.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Close Stations"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.rightmove.co.uk/*",
        "https://www.zoopla.co.uk/*",
        "https://www.onthemarket.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
